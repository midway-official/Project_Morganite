+/* Replay the same raw inflate core without VFS operations or device activity. */
+static void __init replay_inflate(const u8 *input, unsigned long len)
+{
+	const unsigned int block = 32768;
+	int workspace_bytes = zlib_inflate_workspacesize();
+	u8 *output = kmalloc(block, GFP_KERNEL);
+	void *workspace = kmalloc(workspace_bytes, GFP_KERNEL);
+	unsigned int pass;
+
+	if (!output || !workspace || len < 18 || memcmp(input, "\x1f\x8b\x08\x00", 4))
+		panic("unexpected inflate replay setup");
+	for (pass = 0; pass < 4; pass++) {
+		z_stream stream = { .workspace = workspace };
+		unsigned long flags = 0;
+		unsigned long total = 0;
+		unsigned int fill = (pass & 2) ? 0xa5 : 0;
+		u32 crc = ~0U;
+		int rc;
+
+		memset(workspace, fill, workspace_bytes);
+		memset(output, fill, block);
+		if (pass & 1)
+			local_irq_save(flags);
+		stream.next_in = input + 10;
+		stream.avail_in = len - 10;
+		rc = zlib_inflateInit2(&stream, -MAX_WBITS);
+		while (rc == Z_OK) {
+			unsigned long produced;
+
+			stream.next_out = output;
+			stream.avail_out = block;
+			rc = zlib_inflate(&stream, Z_NO_FLUSH);
+			produced = block - stream.avail_out;
+			crc = crc32_le(crc, output, produced);
+			total += produced;
+			if (total > 4 * 1024 * 1024)
+				break;
+		}
+		zlib_inflateEnd(&stream);
+		if (pass & 1)
+			local_irq_restore(flags);
+		pr_info("inflate replay pass=%u irq_masked=%u fill=%02x rc=%d bytes=%lu crc=%08x\n",
+			pass, pass & 1, fill, rc, total, crc ^ ~0U);
+	}
+	kfree(workspace);
+	kfree(output);
+}
